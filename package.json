{
  "name": "hexsec",
  "version": "0.5.1",
  "private": true,
  "description": "HexSec personal Windows music player",
  "license": "MIT",
  "scripts": {
    "start": "electron app",
    "build:provider": "esbuild app/provider-source/aural-entry.ts --bundle --platform=node --format=cjs --outfile=app/provider.cjs",
    "test": "node tests/run.cjs",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "build:web": "node scripts/build-web.cjs"
  },
  "devDependencies": {
    "electron": "45.3.4",
    "esbuild": "0.28.2",
    "jsdom": "31.0.1"
  }
}
